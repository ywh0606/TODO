{
  "name": "todo-app",
  "version": "1.0.4",
  "description": "简洁好用的桌面清单工具",
  "main": "electron/main.js",
  "scripts": {
    "dev": "bash -c 'unset ELECTRON_RUN_AS_NODE && NODE_ENV=development vite & sleep 3 && NODE_ENV=development electron .'",
    "build": "vite build",
    "electron:build": "vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dayjs": "^1.11.0",
    "pinia": "^2.1.0",
    "uuid": "^9.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.10",
    "electron": "28.3.3",
    "electron-builder": "^24.0.0",
    "happy-dom": "^20.9.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
