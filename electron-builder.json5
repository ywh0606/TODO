{
  "appId": "com.todo.app",
  "productName": "Todo App",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "assets/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "artifactName": "Todo.App.Setup.\${version}.\${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "ywh0606",
    "repo": "TODO"
  }
}
